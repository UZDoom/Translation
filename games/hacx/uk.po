msgctxt "doom hacx.hacx1"
msgid "OB_BARREL"
msgstr "%o злови@[adj_1_ua] передоз нітрогліцерином."

msgctxt "doom hacx.hacx1"
msgid "OB_SPLASH"
msgstr "%o рознесло на дрібні шматочки."

#, fuzzy

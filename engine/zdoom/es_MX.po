msgid "QUITMSG"
msgstr ""
"¿Segur@[ao_esp] que quieres\n"
"cerrar este gran juego?"

# In some languages, it may make more sense to translate “Press a key” as
# “Press any key.”
msgid "LOADNET"
msgstr ""
"¡No puedes cargar en una partida en línea!\n"
"\n"
"Presiona cualquier tecla."

msgid "QLOADNET"
msgstr ""
"¡No puedes cargar rápido en una partida en línea!\n"
"\n"
"Presiona cualquier tecla."

msgid "QSAVESPOT"
msgstr ""
"¡No has elegido una ranura para guardado rápido!\n"
"\n"
"Presiona cualquier tecla."

msgid "NEWGAME"
msgstr ""
"No puedes iniciar una nueva\n"
"partida estando en línea.\n"
"\n"
"Presiona cualquier tecla."

msgid "NIGHTMARE"
msgstr ""
"¿Estás segur@[ao_esp]? Esta dificultad\n"
"no es ni remotamente justa.\n"
"\n"
"Presiona Y o N."

msgid "SWSTRING"
msgstr ""
"Esta es la versión shareware de Doom.\n"
"\n"
"Necesitas ordenar la trilogía entera.\n"
"\n"
"Presiona cualquier tecla."

msgid "NETEND"
msgstr ""
"¡No puedes terminar una partida en línea!\n"
"\n"
"Presiona cualquier tecla."

msgid "ENDGAME"
msgstr ""
"¿Estás segur@[ao_esp] de terminar esta partida?\n"
"\n"
"Presiona Y o N."

msgid "RAVENQUITMSG"
msgstr "¿Estás segur@[ao_esp] de que quieres irte?"

msgctxt "heretic"
msgid "SWSTRING"
msgstr "Solo disponible en la versión registrada"

msgid "DOSY"
msgstr "(Presiona Y para salir)"

msgid "QUITMSG1"
msgstr ""
"¡Por favor no te vayas, aún quedan\n"
"demonios para exterminar!"

msgid "QUITMSG2"
msgstr ""
"¡Acabemos con esto! ¡Esto se está\n"
"volviendo un baño de sangre!"

msgid "QUITMSG3"
msgstr ""
"Yo no me iría si fuera tú.\n"
"DOS es muchísimo peor."

msgid "QUITMSG4"
msgstr ""
"Estás intentando decir que prefieres\n"
"más a DOS que a mi, ¿Verdad?"

msgid "QUITMSG5"
msgstr ""
"¡Aún no te vayas—hay un\n"
"demonio por esa esquina!"

msgid "QUITMSG6"
msgstr ""
"Ya sabes, la proxima vez que vengas\n"
"aqui acabaré contigo."

msgid "QUITMSG7"
msgstr "Adelante y vete. A ver si me importa."

# More info here.
msgid "QUITMSG8"
msgstr ""
"¿Quieres irte?\n"
"Pues, ¡has perdido un octavo!"

# A “dimensional shambler” is a creature appearing in the works of H. P.
# Lovecraft.
msgid "QUITMSG9"
msgstr ""
"¡No te vayas ahora, hay un\n"
"vagabundo dimensional esperando\n"
"en la línea de comandos de DOS!"

msgid "QUITMSG10"
msgstr ""
"Lárgate y vuelve a tus\n"
"aburridos programas."

msgid "QUITMSG11"
msgstr ""
"¡Si fuera tu jefe, te retaría a\n"
"un duelo a muerte en un minuto!"

msgid "QUITMSG12"
msgstr ""
"Mira, amig@[ao_esp]. ¡Te vas ahora y\n"
"pierdes el recuento de cadáveres!"

msgid "QUITMSG13"
msgstr ""
"Pues vete. Cuando regreses te\n"
"esperaré con un bate."

msgid "QUITMSG14"
msgstr ""
"Tienes suerte de que no te\n"
"golpee por pensar en irte."

msgid "QUITMSG15"
msgstr ""
"¿A dónde vas?\n"
"¿Qué hay de la rebelión?"

msgid "QUITMSG16"
msgstr ""
"Masacre interruptus…\n"
"¡Qué estafa!"

msgid "QUITMSG17"
msgstr ""
"Pero, eres mi esperanza\n"
"—¡Mi única oportunidad!"

msgid "QUITMSG18"
msgstr "Nadie abandona a Blackbird."

msgid "QUITMSG19"
msgstr "Creí que eras diferente…"

msgid "QUITMSG20"
msgstr "¡Bien, solo mata y corre!"

msgid "QUITMSG21"
msgstr ""
"Podrás correr…\n"
"Pero no esconderte…"

msgid "QUITMSG22"
msgstr ""
"¿Eh, qué pasa, mami\n"
"te llama para cenar?"

msgid "QUITMSG23"
msgstr ""
"¡No te vayas, aún quedan\n"
"flemoides a la deriva!"

msgid "QUITMSG24"
msgstr ""
"No te rindas… ¡o los\n"
"flemoides van a tener ventaja!"

msgid "QUITMSG25"
msgstr ""
"No te vayas.\n"
"¡Necesitamos tu ayuda!"

msgid "QUITMSG26"
msgstr ""
"Espero que tomes el descanso\n"
"disfrutando de Chex® Party Mix."

msgid "QUITMSG27"
msgstr ""
"¡No te salgas!\n"
"¡Necesitamos tu ayuda!"

msgid "QUITMSG28"
msgstr ""
"¡No abandones la Federación\n"
"Intergaláctica de Cereales!"

msgid "QUITMSG29"
msgstr ""
"¡El verdadero Guerrero Chex®\n"
"no se rendiría tan rápido!"

